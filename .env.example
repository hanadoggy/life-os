# ==============================================================================
# Application & Server
# ==============================================================================
PORT=8080
APP_ENV=development
APP_BASE_URL=http://localhost:5173
TZ=Asia/Tokyo

# ==============================================================================
# Database (PostgreSQL 18)
# ==============================================================================
POSTGRES_USER=lifeos
POSTGRES_PASSWORD=lifeos_dev_password
POSTGRES_DB=lifeos_dev
DATABASE_URL=postgres://lifeos:lifeos_dev_password@localhost:5432/lifeos_dev?sslmode=disable
TEST_DATABASE_URL=postgres://lifeos:lifeos_dev_password@localhost:5432/lifeos_test?sslmode=disable

# ==============================================================================
# Authentication (Google OAuth 2.0 + Server Session)
# ==============================================================================
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:5173/auth/google/callback
ALLOWED_USER_EMAIL=you@example.com

# ==============================================================================
# Google Sheets Sync (Write-behind Outbox & Migration)
# ==============================================================================
SHEETS_ENABLED=false
SHEETS_SPREADSHEET_IDS=2025=your_2025_spreadsheet_id,2026=your_2026_spreadsheet_id
SHEETS_MONTH_TAB_FORMAT={Month}
SHEETS_TXID_COLUMN=Z
SHEETS_APP_LOG_TAB=app_log

